package tests;

use ecosystem::pipeline;
use std::task;
use std::testing;

#[test]
fn resource_generators_release_once_for_exhaustion_stop_and_failures() -> () {
    for mode in 0..4 {
        let acquired = Ref::new(0);
        let released = Ref::new(0);
        let stream: pipeline::Stream[isize, string] = pipeline::generate_resource(
            |_| {
                acquired.set(acquired.get() + 1);
                Result::Ok(Ref::new(0))
            },
            |_, resource| {
                let index = resource.get();
                resource.set(index + 1);
                if mode == 2 && index == 1 {
                    return Result::Err("source failure")
                }
                Result::Ok(
                    if index < 3 {
                        Option::Some(index)
                    } else {
                        Option::None
                    },
                )
            },
            |_| released.set(released.get() + 1),
        );
        for run in 1..3 {
            let result = if mode == 1 {
                testing::expect_ok(stream.take(1), "take").collect(pipeline::RunOptions::standard())
            } else if mode == 3 {
                stream.try_map(|_, _| Result::Err("sink failure")).collect(
                    pipeline::RunOptions::standard(),
                )
            } else {
                stream.collect(pipeline::RunOptions::standard())
            };
            if mode >= 2 {
                testing::assert_err(result);
            } else {
                testing::assert_eq(
                    testing::expect_ok(result, "collected").len(),
                    if mode == 1 {
                        1
                    } else {
                        3
                    },
                );
            }
            testing::assert_eq(acquired.get(), run);
            testing::assert_eq(released.get(), run);
        }
    }
}

#[test]
fn failed_acquisition_and_cancelled_acquisition_have_distinct_cleanup() -> () {
    let released = Ref::new(0);
    let stream: pipeline::Stream[isize, string] = pipeline::generate_resource(
        |_| Result::Err("cannot open"),
        |_, _: isize| Result::Ok(Option::None),
        |_| released.set(released.get() + 1),
    );
    let error = testing::expect_err(
        stream.collect(pipeline::RunOptions::standard()),
        "acquisition failed",
    );
    testing::assert_eq(error.stage, "source/acquire");
    testing::assert_eq(released.get(), 0);
    task::scope(
        |scope| {
            let reads = Ref::new(0);
            let stream: pipeline::Stream[isize, string] = pipeline::generate_resource(
                |_| {
                    scope.cancel();
                    Result::Ok(())
                },
                |_, _| {
                    reads.set(reads.get() + 1);
                    Result::Ok(Option::Some(1))
                },
                |_| released.set(released.get() + 1),
            );
            let options = pipeline::RunOptions::standard().with_cancel(scope.token());
            testing::assert_eq(
                testing::expect_err(stream.collect(options), "cancelled").kind,
                pipeline::ErrorKind::Cancelled,
            );
            testing::assert_eq(released.get(), 1);
            testing::assert_eq(reads.get(), 0);
            testing::assert_err(stream.collect(options));
            testing::assert_eq(released.get(), 1);
        },
    );
}
